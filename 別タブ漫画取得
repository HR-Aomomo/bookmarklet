javascript:(function(){const openerWindow=window;const openerDoc=document;openerWindow.scrollTo(0,0);const width=Math.min(window.screen.width*0.85,1100);const height=Math.min(window.screen.height*0.8,800);const left=(window.screen.width-width)/2;const top=(window.screen.height-height)/2;const win=window.open('','_blank',`width=${width},height=${height},left=${left},top=${top},resizable=yes,scrollbars=yes`);if(!win){alert('ポップアップがブロックされました。ポップアップを許可して再度お試しください。');return;}const pageUrl=openerWindow.location.href;const baseName=openerDoc.title||"download";win.document.write(`<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"><title>画像抽出ツール (均一比率・白紙埋め版)</title><script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script><style>:root{--cw:110px;--card-ratio:1;}body{margin:0;background:#1e1e1e;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;height:100vh;overflow:hidden;box-sizing:border-box;}.header{padding:10px 15px;background:#252526;border-bottom:1px solid #3e3e42;display:flex;flex-direction:column;gap:8px;flex-shrink:0;}.top-row{display:flex;justify-content:space-between;align-items:center;}h3{margin:0;font-size:15px;}.badge{font-size:12px;background:#007acc;padding:3px 8px;border-radius:20px;}.controls{display:flex;gap:5px;}.controls button{padding:5px;background:#555;color:white;border:none;border-radius:4px;cursor:pointer;flex:1;font-weight:bold;font-size:11px;}#btn-stop{background:#d97706;}.setting-row{display:flex;align-items:center;gap:10px;font-size:12px;color:#ccc;width:100%;}.setting-row input[type="text"],.setting-row input[type="number"],.setting-row select{padding:6px;background:#333;color:#fff;border:1px solid #555;border-radius:4px;box-sizing:border-box;flex:1;}.slider-box{display:flex;align-items:center;gap:10px;font-size:12px;color:#ccc;background:#2d2d30;padding:4px 8px;border-radius:4px;}.slider-box input{flex:1;cursor:pointer;}.actions{display:flex;flex-direction:column;gap:4px;}#btn-zip{padding:8px;background:#007acc;color:white;border:none;border-radius:4px;cursor:pointer;font-weight:bold;width:100%;font-size:12px;}.action-sub{display:flex;gap:5px;}#btn-single{padding:6px;background:#e67e22;color:white;border:none;border-radius:4px;cursor:pointer;flex:1;font-size:11px;font-weight:bold;}#btn-close{padding:6px;background:#d32f2f;color:white;border:none;border-radius:4px;cursor:pointer;flex:1;font-size:11px;font-weight:bold;}#gallery-wrapper{flex:1;overflow-y:auto;overflow-x:hidden;background:#1e1e1e;}#gallery{padding:4px;user-select:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--cw),1fr));gap:4px;align-items:start;}.card{position:relative;width:100%;aspect-ratio:var(--card-ratio);background:#2d2d30;border:2px solid transparent;border-radius:2px;cursor:pointer;box-sizing:border-box;display:block;overflow:hidden;}.card img{width:100%;height:100%;object-fit:contain;background:#ffffff;display:block;pointer-events:none;}.card .info{position:absolute;bottom:0;left:0;width:100%;background:rgba(0,0,0,0.75);color:#fff;font-size:10px;padding:4px;box-sizing:border-box;pointer-events:none;display:flex;flex-direction:column;line-height:1.2;}.card .info-name{font-weight:bold;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.card .info-meta{color:#aaa;font-size:9px;margin-top:1px;}.card .check{position:absolute;top:4px;right:4px;width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,0.5);border:1px solid #aaa;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;font-size:12px;pointer-events:none;z-index:2;}#modal{position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.9);z-index:99999;display:none;align-items:center;justify-content:center;cursor:default;}.modal-content{position:relative;max-width:95vw;max-height:95vh;display:flex;align-items:center;justify-content:center;}#modal-img{max-width:95vw;max-height:95vh;object-fit:contain;pointer-events:none;}.modal-badge{position:absolute;top:15px;left:15px;background:rgba(0,0,0,0.7);border:2px solid #fff;color:#fff;padding:8px 14px;border-radius:20px;font-size:14px;font-weight:bold;display:flex;align-items:center;gap:8px;cursor:pointer;z-index:10;user-select:none;}.modal-badge.checked{background:#3b82f6;border-color:#3b82f6;}.modal-counter{position:absolute;bottom:15px;right:15px;background:rgba(0,0,0,0.7);color:#fff;padding:6px 12px;border-radius:4px;font-size:12px;pointer-events:none;}</style></head><body><div class="header"><div class="top-row"><h3>画像抽出 (均一比率・白紙埋め版)</h3><div class="badge"><span id="sel-cnt">0</span> / <span id="tot-cnt">0</span> 枚</div></div><div style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;background:#333;padding:8px;border-radius:8px;box-sizing:border-box;"><div style="display:flex;flex-direction:column;gap:2px;"><span style="font-size:10px;color:#ccc;">最小(px)</span><div style="display:flex;gap:2px;align-items:center;"><input type="number" id="filter-width" value="300" style="width:50px;padding:4px;font-size:11px;flex:none;"> <span style="color:#888;font-size:11px;">x</span> <input type="number" id="filter-height" value="0" style="width:50px;padding:4px;font-size:11px;flex:none;"></div></div><div style="display:flex;flex-direction:column;gap:2px;"><span style="font-size:10px;color:#ccc;">比率</span><select id="filter-ratio" style="padding:4px;font-size:11px;flex:none;"><option value="all">全て</option><option value="landscape">横</option><option value="portrait">縦</option><option value="square">正方</option></select></div><div style="display:flex;flex-direction:column;gap:2px;"><span style="font-size:10px;color:#ccc;">拡張子</span><input type="text" id="filter-ext" placeholder="jpg, png" value="" style="width:60px;padding:4px;font-size:11px;flex:none;"></div><button id="btn-apply-filter" style="padding:4px 8px;background:#4caf50;color:white;border:none;border-radius:4px;cursor:pointer;font-weight:bold;font-size:11px;">絞込適用</button></div><div class="controls"><button id="btn-all">全選択</button><button id="btn-none">全解除</button><button id="btn-stop">自動スクロール停止</button></div><div class="setting-row"><span style="white-space:nowrap;">ZIP名:</span><input type="text" id="zip-filename" value="${baseName}"></div><div class="slider-box"><span>サイズ:</span><input type="range" id="size-slider" min="80" max="400" value="110"><span id="size-val">110px</span></div><div class="actions"><button id="btn-zip">ZIPで一括保存</button><div class="action-sub"><button id="btn-single">個別保存</button><button id="btn-close">ウィンドウを閉じる</button></div></div></div><div id="gallery-wrapper"><div id="gallery"></div></div><div id="modal"><div class="modal-content" id="modal-box"><div id="modal-status" class="modal-badge">✓ 選択中</div><img id="modal-img" src=""><div id="modal-counter" class="modal-counter">1 / 1</div></div></div></body></html>%60);win.document.close();win.onload=function(){const gallery=win.document.getElementById("gallery");const modal=win.document.getElementById("modal");const modalBox=win.document.getElementById("modal-box");const modalImg=win.document.getElementById("modal-img");const modalStatus=win.document.getElementById("modal-status");const modalCounter=win.document.getElementById("modal-counter");const allImages=[];const uniqueUrls=new Set();let isRightMouseDown=false;let touchedCardsDuringDrag=new Set();let currentModalIndex=-1;const ratioCounts={};const updateDominantRatio=(w,h)=>{if(w===0||h===0)return;const r=w/h;const key=Math.round(r*100)/100;ratioCounts[key]=(ratioCounts[key]||0)+1;let max=0;let best=1;for(let k in ratioCounts){if(ratioCounts[k]>max){max=ratioCounts[k];best=k;}}win.document.documentElement.style.setProperty('--card-ratio',best);};const getVisibleImages=()=>allImages.filter(img=>img.visible);const updateCount=()=>{const visible=getVisibleImages();const sel=visible.filter(i=>i.selected).length;const selEl=win.document.getElementById("sel-cnt");const totEl=win.document.getElementById("tot-cnt");if(selEl)selEl.textContent=sel;if(totEl)totEl.textContent=visible.length;};const setCardState=(imgObj,selected)=>{imgObj.selected=selected;if(imgObj.card){imgObj.card.style.borderColor=selected?'#007acc':'transparent';const check=imgObj.card.querySelector('.check');if(check){check.style.background=selected?'#007acc':'rgba(0,0,0,0.5)';check.style.borderColor=selected?'#007acc':'#aaa';check.textContent=selected?'✓':'';}}if(currentModalIndex>=0){const visible=getVisibleImages();if(visible[currentModalIndex]===imgObj){updateModalStatus();}}};const updateModalStatus=()=>{const visible=getVisibleImages();if(currentModalIndex<0||currentModalIndex>=visible.length)return;const imgObj=visible[currentModalIndex];modalImg.src=imgObj.url;modalCounter.textContent=%60${currentModalIndex+1} / ${visible.length}%60;if(imgObj.selected){modalStatus.className="modal-badge checked";modalStatus.textContent="✓ 選択中 (右クリック解除)";}else{modalStatus.className="modal-badge";modalStatus.textContent="✕ 未選択 (右クリック選択)";}};const openModal=(imgObj)=>{const visible=getVisibleImages();const idx=visible.indexOf(imgObj);if(idx!==-1){currentModalIndex=idx;updateModalStatus();modal.style.display="flex";}};const closeModal=()=>{modal.style.display="none";currentModalIndex=-1;};const nextImage=()=>{const visible=getVisibleImages();if(visible.length===0)return;currentModalIndex=(currentModalIndex+1)%visible.length;updateModalStatus();};const prevImage=()=>{const visible=getVisibleImages();if(visible.length===0)return;currentModalIndex=(currentModalIndex-1+visible.length)%visible.length;updateModalStatus();};modal.oncontextmenu=(e)=>{e.preventDefault();const visible=getVisibleImages();if(currentModalIndex>=0&&visible[currentModalIndex]){const target=visible[currentModalIndex];setCardState(target,!target.selected);updateCount();}};modal.onclick=(e)=>{if(e.target.id==='modal-status'||e.target.closest('.modal-badge')){return;}if(e.target===modal||e.target===modalBox||e.target===modalImg){closeModal();}};win.onkeydown=(e)=>{if(modal.style.display==="flex"){if(e.key==="Escape"){closeModal();}else if(e.key==="ArrowRight"||e.key==="ArrowDown"||e.key==="d"||e.key==="s"){nextImage();}else if(e.key==="ArrowLeft"||e.key==="ArrowUp"||e.key==="a"||e.key==="w"){prevImage();}}};modal.onwheel=(e)=>{e.preventDefault();if(e.deltaY>0){nextImage();}else{prevImage();}};const renderCard=imgObj=>{if(!imgObj.card){const card=win.document.createElement("div");card.className="card";const imgTag=win.document.createElement("img");imgTag.src=imgObj.previewUrl;const info=win.document.createElement("div");info.className="info";const dims=imgObj.width>0?%60${imgObj.width}x${imgObj.height}%60:"?";info.innerHTML=%60<div class="info-name" title="${imgObj.filename}">${imgObj.filename}</div><div class="info-meta">${dims} / ${imgObj.ext.toUpperCase()}</div>%60;const check=win.document.createElement("div");check.className="check";card.appendChild(imgTag);card.appendChild(info);card.appendChild(check);imgObj.card=card;card.onclick=()=>{openModal(imgObj);};card.onmouseover=()=>{if(isRightMouseDown&&!touchedCardsDuringDrag.has(imgObj)){touchedCardsDuringDrag.add(imgObj);setCardState(imgObj,!imgObj.selected);updateCount();}};gallery.appendChild(card);}setCardState(imgObj,imgObj.selected);imgObj.card.style.display=imgObj.visible?"block":"none";};gallery.oncontextmenu=(e)=>e.preventDefault();gallery.onmousedown=(e)=>{if(e.button===2){isRightMouseDown=true;touchedCardsDuringDrag.clear();const targetCard=e.target.closest('.card');if(targetCard){const found=allImages.find(i=>i.card===targetCard);if(found){touchedCardsDuringDrag.add(found);setCardState(found,!found.selected);updateCount();}}}};win.addEventListener('mouseup',(e)=>{if(e.button===2){isRightMouseDown=false;touchedCardsDuringDrag.clear();}});const addImage=(url,w,h)=>{if(!url||url.startsWith("data:")||uniqueUrls.has(url))return;const urlWithoutQuery=url.split("?")[0];const extMatch=urlWithoutQuery.match(/\.([^.]+)$/);const ext=extMatch?extMatch[1].toLowerCase():"unknown";if(["gif","svg","mp4"].includes(ext))return;uniqueUrls.add(url);let fname=urlWithoutQuery.split("/").pop();if(!fname)fname="image."+ext;try{fname=decodeURIComponent(fname);}catch(e){}const imgObj={url:url,previewUrl:url,width:w||0,height:h||0,ext:ext,filename:fname,selected:true,visible:true};updateDominantRatio(w,h);allImages.push(imgObj);renderCard(imgObj);};const extractImages=()=>{openerDoc.querySelectorAll("img").forEach(img=>{const raw=img.getAttribute("data-src")||img.getAttribute("data-original")||img.getAttribute("data-lazy-src")||img.getAttribute("data-lazy")||img.src;if(raw){try{const abs=new URL(raw,openerWindow.location.href).href;addImage(abs,img.naturalWidth||img.width,img.naturalHeight||img.height);}catch(e){}}});updateCount();};win.document.getElementById("btn-all").onclick=()=>{getVisibleImages().forEach(i=>setCardState(i,true));updateCount();};win.document.getElementById("btn-none").onclick=()=>{getVisibleImages().forEach(i=>setCardState(i,false));updateCount();};const slider=win.document.getElementById("size-slider");const sizeVal=win.document.getElementById("size-val");slider.oninput=(e)=>{const val=e.target.value;sizeVal.textContent=val+"px";win.document.documentElement.style.setProperty('--cw',val+'px');};let scrollTimer;let waitCount=0;let lastImageCount=0;const startExtraction=()=>{extractImages();lastImageCount=uniqueUrls.size;scrollTimer=setInterval(()=>{if(win.closed){clearInterval(scrollTimer);return;}openerWindow.scrollBy(0,800);extractImages();if(uniqueUrls.size===lastImageCount){waitCount++;if(waitCount>=5){clearInterval(scrollTimer);const btn=win.document.getElementById("btn-stop");if(btn){btn.textContent="読込完了";btn.disabled=true;btn.style.background="#4caf50";}}}else{lastImageCount=uniqueUrls.size;waitCount=0;}},500);};setTimeout(startExtraction,500);win.document.getElementById("btn-stop").onclick=()=>{clearInterval(scrollTimer);const btn=win.document.getElementById("btn-stop");if(btn){btn.textContent="停止済";btn.disabled=true;btn.style.background="#777";}};win.document.getElementById("btn-apply-filter").onclick=()=>{const minWidth=parseInt(win.document.getElementById("filter-width").value)||0;const minHeight=parseInt(win.document.getElementById("filter-height").value)||0;const ratio=win.document.getElementById("filter-ratio").value;const exts=win.document.getElementById("filter-ext").value.toLowerCase().split(",").map(e=>e.trim()).filter(e=>e);allImages.forEach(img=>{let ok=true;if(img.width>0&&img.height>0){if(img.width<minWidth||img.height<minHeight)ok=false;if(ratio==="landscape"&&img.width<=img.height)ok=false;if(ratio==="portrait"&&img.width>=img.height)ok=false;if(ratio==="square"&&img.width!==img.height)ok=false;}if(exts.length>0&&!exts.includes(img.ext))ok=false;img.visible=ok;if(img.card){img.card.style.display=ok?"block":"none";}if(ok){setCardState(img,true);}else{setCardState(img,false);}});updateCount();};win.document.getElementById("btn-zip").onclick=async()=>{const targets=getVisibleImages().filter(i=>i.selected);if(targets.length===0)return;const btn=win.document.getElementById("btn-zip");const originalText=btn.textContent;btn.textContent="ZIP処理中...";btn.disabled=true;if(!win.JSZip){alert("JSZipライブラリの読み込みに失敗しました。");btn.textContent=originalText;btn.disabled=false;return;}const zip=new win.JSZip();const chunkSize=5;for(let i=0;i<targets.length;i+=chunkSize){btn.textContent=%60ダウンロード中... (${i+1}/${targets.length})%60;const chunk=targets.slice(i,i+chunkSize);await Promise.all(chunk.map(async(img,idx)=>{try{const response=await fetch(img.url);if(!response.ok)throw new Error("Network");const blob=await response.blob();zip.file((i+idx+1)+"_"+img.filename,blob);}catch(e){}}));}btn.textContent="ZIP生成中...";try{const content=await zip.generateAsync({type:"blob"});const a=win.document.createElement("a");a.href=URL.createObjectURL(content);let zipName=win.document.getElementById("zip-filename").value.trim();if(!zipName)zipName="download";a.download=zipName+".zip";win.document.body.appendChild(a);a.click();win.document.body.removeChild(a);URL.revokeObjectURL(a.href);btn.textContent="完了!";}catch(e){btn.textContent="エラー発生";}setTimeout(()=>{btn.textContent=originalText;btn.disabled=false;},2000);};win.document.getElementById("btn-single").onclick=async()=>{const targets=getVisibleImages().filter(i=>i.selected);if(targets.length===0)return;const btn=win.document.getElementById("btn-single");const originalText=btn.textContent;btn.textContent="処理中...";btn.disabled=true;for(let i=0;i<targets.length;i++){try{const res=await fetch(targets[i].url);const blob=await res.blob();const a=win.document.createElement("a");a.href=URL.createObjectURL(blob);a.download=targets[i].filename;win.document.body.appendChild(a);a.click();win.document.body.removeChild(a);URL.revokeObjectURL(a.href);await new Promise(r=>setTimeout(r,200));}catch(e){console.error(e);}}btn.textContent="完了!";setTimeout(()=>{btn.textContent=originalText;btn.disabled=false;},2000);};};})();
